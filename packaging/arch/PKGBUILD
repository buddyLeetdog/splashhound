# Maintainer: Leetdog <buddyLeetdog@users.noreply.github.com>
pkgname=splashhound
pkgver=1.0.0
pkgrel=1
pkgdesc="Local-first video library categorizer and viewer"
arch=('x86_64')
url="https://github.com/buddyLeetdog/splashhound"
license=('GPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'libayatana-appindicator')
makedepends=('rust' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# The GitHub repository must be public for AUR builds. After making it public,
# run `updpkgsums` in this directory to replace SKIP with the real checksum.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 src-tauri/target/release/splashhound "$pkgdir/usr/bin/splashhound"
  install -Dm644 packaging/linux/splashhound.desktop \
    "$pkgdir/usr/share/applications/splashhound.desktop"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/splashhound.png"
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/splashhound.png"
  install -Dm644 src-tauri/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/splashhound.png"
}
